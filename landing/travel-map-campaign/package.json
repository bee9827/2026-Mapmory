{
  "name": "travel-map-campaign",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs && npm run build:trip",
    "build:trip": "vite build --base=/trip/ --outDir dist/trip",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "preview:trip": "vite preview --base=/trip/ --outDir dist/trip",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "d3-geo": "3.1.1",
    "exifr": "7.1.3",
    "exifreader": "^4.44.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "topojson-client": "3.1.0",
    "vite": "6.4.3",
    "world-atlas": "2.0.2"
  }
}
