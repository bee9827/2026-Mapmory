# Public Google Play listing. Production falls back to this URL when the variable is omitted.
VITE_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.mapmory.android

# GA4 web stream measurement ID. The production build defaults to Mapmory's public stream ID.
VITE_GA_MEASUREMENT_ID=G-MC93CZWLZF

# PostHog project settings. Leave both empty to disable PostHog safely.
# Use the exact host shown in the PostHog project setup screen.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Keep local preview traffic out of production analytics by default.
VITE_POSTHOG_CAPTURE_LOCAL=false

# Stable page revision used to compare measurements before and after landing changes.
VITE_LANDING_VERSION=v3

# Backend origin. Leave empty when Nginx proxies /api on the same origin.
VITE_API_BASE_URL=https://api.map-mory.com
